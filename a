<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>МАРБЛДРОМ · Сезон 01</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Manrope:wght@400;600;800&family=Oswald:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --void:#050e12; --deep:#0a1a20; --road:#15262c;
  --sand:#f0c268; --sand-d:#a8762c;
  --coral:#ff5a45; --mint:#42e2a8;
  --ice:#eaf5f7; --steel:#6e8d97; --line:#1d3740;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{
  background:var(--void); color:var(--ice);
  font-family:'Manrope',system-ui,sans-serif;
  user-select:none;-webkit-user-select:none;touch-action:none;overscroll-behavior:none;
}
#app{position:fixed;inset:0;overflow:hidden}
canvas{position:absolute;inset:0;display:block}
.grain{position:absolute;inset:0;pointer-events:none;z-index:3;opacity:.07;mix-blend-mode:overlay;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)'/></svg>")}
.scan{position:absolute;inset:0;pointer-events:none;z-index:3;opacity:.16;
  background:repeating-linear-gradient(180deg,rgba(0,0,0,.55) 0 1px,transparent 1px 3px)}

/* ── HUD ────────────────────────────── */
.hud{position:absolute;inset:0;z-index:4;pointer-events:none;text-transform:uppercase}
.hud b{font-weight:700}
.top{position:absolute;left:0;right:0;top:0;padding:calc(10px + env(safe-area-inset-top)) 14px 0;
  display:flex;justify-content:space-between;align-items:flex-start}
.tele .lbl{font-family:'Oswald';font-size:10px;letter-spacing:2.4px;color:var(--steel)}
.tele .v{font-family:'JetBrains Mono';font-weight:700;font-size:clamp(30px,9.4vw,44px);line-height:.86;
  letter-spacing:-2px;color:#fff;text-shadow:0 3px 0 rgba(0,0,0,.55)}
.tele .v i{font-style:normal;font-size:.42em;letter-spacing:1px;color:var(--sand);margin-left:3px}
.tele .spd{font-family:'Oswald';font-size:13px;letter-spacing:1.4px;color:var(--sand);margin-top:2px}
.right{text-align:right}
.sclbl{font-family:'Oswald';font-size:10px;letter-spacing:2.4px;color:var(--steel)}
.scv{font-family:'Oswald';font-weight:700;font-size:clamp(24px,7vw,32px);line-height:.9;letter-spacing:-.5px;color:#fff}
.bestchip{display:inline-block;font-family:'JetBrains Mono';font-size:10px;letter-spacing:1px;color:var(--steel);
  border:1px solid var(--line);padding:2px 7px;margin-top:4px;transform:skewX(-12deg)}
.icons{display:flex;gap:6px;justify-content:flex-end;margin-top:8px}
.ib{pointer-events:auto;width:32px;height:32px;display:grid;place-items:center;border:1px solid var(--line);
  background:rgba(9,26,32,.72);color:var(--steel);font-family:'Oswald';font-size:13px;cursor:pointer;
  transform:skewX(-10deg);transition:.15s}
.ib:active{background:var(--sand);color:#08181e;border-color:var(--sand)}
.ib.off{opacity:.4}

.combo{position:absolute;left:50%;top:calc(84px + env(safe-area-inset-top));transform:translateX(-50%) skewX(-9deg);
  padding:5px 16px 6px;background:var(--mint);color:#04181a;font-family:'Oswald';font-weight:700;font-size:23px;
  letter-spacing:.5px;opacity:0;transition:opacity .18s;box-shadow:0 0 26px rgba(66,226,168,.45)}
.combo.on{opacity:1}
.combo.pop{animation:pop .3s cubic-bezier(.2,1.4,.4,1)}
@keyframes pop{0%{transform:translateX(-50%) skewX(-9deg) scale(1.5)}100%{transform:translateX(-50%) skewX(-9deg) scale(1)}}

.btm{position:absolute;left:0;right:0;bottom:0;padding:0 14px calc(14px + env(safe-area-inset-bottom));
  display:flex;align-items:flex-end;justify-content:space-between;gap:12px}
.hullwrap .lbl{font-family:'Oswald';font-size:9px;letter-spacing:2.2px;color:var(--steel);margin-bottom:5px}
.hull{display:flex;gap:5px}
.hull i{width:32px;height:10px;background:#0f242b;border:1px solid #23444e;transform:skewX(-18deg);transition:.18s}
.hull i.on{background:linear-gradient(180deg,#6df3c4,var(--mint));border-color:#8dffdb;box-shadow:0 0 14px rgba(66,226,168,.5)}
.hullwrap.crit .hull i.on{background:linear-gradient(180deg,#ff9c8c,var(--coral));border-color:#ffb0a3;box-shadow:0 0 16px rgba(255,90,69,.6);animation:blip .55s infinite}
@keyframes blip{50%{opacity:.42}}
.nitro{pointer-events:auto;position:relative;width:76px;height:76px;border:0;border-radius:50%;cursor:pointer;
  background:conic-gradient(var(--sand) calc(var(--f,0)*1%), #0f242b 0);
  box-shadow:0 0 0 1px #24444e, 0 8px 24px rgba(0,0,0,.5);transition:transform .1s}
.nitro s{position:absolute;inset:7px;border-radius:50%;background:#08191f;display:grid;place-items:center;
  font-family:'Oswald';font-weight:700;font-size:12px;letter-spacing:1.4px;color:#4d6a73;text-decoration:none;line-height:1}
.nitro.rdy s{background:var(--sand);color:#08181e;box-shadow:0 0 28px rgba(240,194,104,.55)}
.nitro.rdy{animation:nr 1.5s infinite}
@keyframes nr{50%{box-shadow:0 0 0 1px var(--sand),0 0 30px rgba(240,194,104,.4)}}
.nitro:active{transform:scale(.93)}

.banner{position:absolute;left:0;right:0;top:31%;text-align:center;z-index:5;pointer-events:none;opacity:0;
  font-family:'Oswald';font-weight:700;font-size:clamp(26px,7.6vw,42px);letter-spacing:2px;color:var(--sand);
  text-transform:uppercase;text-shadow:0 4px 0 rgba(0,0,0,.55)}
.banner small{display:block;font-size:12px;letter-spacing:3px;color:var(--mint);font-family:'JetBrains Mono'}
.banner.go{animation:bnr 1.5s cubic-bezier(.15,.9,.2,1)}
@keyframes bnr{0%{opacity:0;transform:skewX(-9deg) scale(.6) translateY(20px)}
  16%{opacity:1;transform:skewX(-9deg) scale(1.05) translateY(0)}
  68%{opacity:1}100%{opacity:0;transform:skewX(-9deg) translateY(-30px)}}

/* ── SCREENS ─────────────────────────── */
.wrap{position:absolute;inset:0;z-index:6;display:flex;flex-direction:column;justify-content:flex-end}
.wrap.off{display:none}
.ghost{position:absolute;right:-4vw;top:calc(-2vw + env(safe-area-inset-top));font-family:'Oswald';font-weight:700;
  font-size:min(44vw,290px);line-height:.72;color:transparent;-webkit-text-stroke:1.5px rgba(240,194,104,.13);
  transform:skewX(-9deg);pointer-events:none}
.brand{position:absolute;left:0;top:calc(16px + env(safe-area-inset-top));padding:0 18px;pointer-events:none}
.season{display:inline-block;font-family:'JetBrains Mono';font-size:10px;letter-spacing:2.6px;color:#08181e;
  background:var(--sand);padding:3px 9px;transform:skewX(-12deg);margin-bottom:10px}
.wordmark{font-family:'Oswald';font-weight:700;font-size:clamp(44px,15.4vw,76px);line-height:.8;letter-spacing:-2px;
  transform:skewX(-9deg);text-transform:uppercase;color:#fff;text-shadow:0 5px 0 rgba(0,0,0,.45)}
.wordmark em{display:block;font-style:normal;color:transparent;-webkit-text-stroke:2px var(--sand)}
.tagline{margin-top:12px;max-width:15em;font-size:12.5px;line-height:1.45;color:var(--steel);transform:skewX(-4deg)}

.sheet{background:linear-gradient(180deg,#0e242c 0%,#061318 100%);border-top:2px solid var(--sand);
  border-radius:22px 22px 0 0;padding:16px 18px calc(18px + env(safe-area-inset-bottom));
  box-shadow:0 -22px 60px rgba(0,0,0,.7);position:relative;overflow:hidden}
.sheet::after{content:'';position:absolute;left:0;right:0;top:0;height:3px;
  background:repeating-linear-gradient(115deg,var(--sand) 0 14px,#0e242c 14px 28px)}
.grip{width:52px;height:4px;background:var(--sand);opacity:.45;border-radius:2px;margin:2px 0 14px}
.strip{display:flex;align-items:baseline;gap:16px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  padding:9px 0;margin-bottom:14px}
.strip i{font-style:normal;display:block;font-family:'Oswald';font-size:9px;letter-spacing:2px;color:var(--steel)}
.strip b{font-family:'JetBrains Mono';font-size:17px;color:#fff;letter-spacing:-.5px}
.strip .gr{flex:1;text-align:right}
.strip .lg-name b{color:var(--sand);font-family:'Oswald';font-size:15px;letter-spacing:1px}

.lg{display:flex;align-items:center;gap:10px;margin:0 0 14px}
.lg .t{flex:1;height:7px;background:#0f242b;position:relative;overflow:hidden;transform:skewX(-18deg);
  border:1px solid var(--line)}
.lg .f{position:absolute;inset:0 auto 0 0;width:0;background:linear-gradient(90deg,var(--mint),var(--sand));
  transition:width .7s cubic-bezier(.2,.9,.2,1)}
.lg .n{font-family:'Oswald';font-size:10px;letter-spacing:1.8px;color:var(--steel);white-space:nowrap}

.cta{display:block;width:100%;border:0;background:var(--sand);color:#08181e;font-family:'Oswald';font-weight:700;
  font-size:clamp(21px,6vw,27px);letter-spacing:1.2px;text-transform:uppercase;padding:15px 12px;cursor:pointer;
  transform:skewX(-9deg);box-shadow:0 6px 0 var(--sand-d),0 16px 32px rgba(0,0,0,.45);transition:transform .07s,box-shadow .07s}
.cta>span{display:inline-block;transform:skewX(9deg)}
.cta>span u{text-decoration:none;font-size:.62em;opacity:.6;margin-left:8px;letter-spacing:2px}
.cta:active{transform:skewX(-9deg) translateY(5px);box-shadow:0 1px 0 var(--sand-d),0 6px 16px rgba(0,0,0,.4)}
.cta.ghostbtn{background:transparent;color:var(--sand);box-shadow:inset 0 0 0 2px var(--sand-d);font-size:16px;padding:11px}
.cta.ghostbtn:active{transform:skewX(-9deg) translateY(2px)}

.howto{list-style:none;margin-top:14px;display:flex;flex-direction:column;gap:9px}
.howto li{display:flex;gap:10px;align-items:center;font-size:12px;color:#9fb9c1;line-height:1.3}
.howto li kbd{flex:none;min-width:26px;height:26px;display:grid;place-items:center;font-family:'Oswald';font-size:12px;
  color:var(--sand);border:1px solid var(--sand-d);background:rgba(240,194,104,.07);transform:skewX(-12deg)}
.howto li b{color:#fff;font-weight:800}

/* game over */
.verdict{font-family:'Oswald';font-weight:700;font-size:clamp(30px,10.5vw,52px);line-height:.86;letter-spacing:-1.5px;
  transform:skewX(-9deg);text-transform:uppercase;color:var(--coral);margin-bottom:6px;text-shadow:0 4px 0 rgba(0,0,0,.5)}
.verdict.win{color:var(--mint)}
.bigsc{display:flex;align-items:flex-end;gap:10px;transform:skewX(-9deg)}
.bigsc b{font-family:'JetBrains Mono';font-weight:700;font-size:clamp(48px,17vw,86px);line-height:.82;color:#fff;letter-spacing:-4px}
.bigsc i{font-style:normal;font-family:'Oswald';font-size:12px;letter-spacing:2.6px;color:var(--steel);padding-bottom:8px}
.flare{display:inline-block;margin-top:8px;font-family:'Oswald';font-size:12px;letter-spacing:2.4px;color:#08181e;
  background:var(--mint);padding:4px 11px;transform:skewX(-12deg);animation:fl .9s infinite}
@keyframes fl{50%{background:var(--sand)}}
.grid4{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);margin-bottom:14px}
.grid4 div{background:#0a1d24;padding:9px 11px}
.grid4 i{font-style:normal;display:block;font-family:'Oswald';font-size:9px;letter-spacing:1.8px;color:var(--steel)}
.grid4 b{font-family:'JetBrains Mono';font-size:19px;color:#fff;letter-spacing:-.5px}
.grid4 b em{font-style:normal;font-size:11px;color:var(--sand)}
.hint{text-align:center;font-family:'Oswald';font-size:10px;letter-spacing:2.4px;color:#4d6a73;margin-top:11px}
.pausecard{margin:auto;background:linear-gradient(180deg,#0e242c,#061318);border:1px solid var(--line);
  padding:26px 24px;width:min(84vw,330px);text-align:left}
.pausecard h3{font-family:'Oswald';font-size:30px;letter-spacing:-.5px;text-transform:uppercase;transform:skewX(-9deg);margin-bottom:18px}
.pausecard .cta+.cta{margin-top:10px}
</style>
</head>
<body>
<div id="app">
  <canvas id="cv"></canvas>
  <div class="scan"></div><div class="grain"></div>

  <!-- HUD -->
  <div class="hud">
    <div class="top">
      <div class="tele">
        <div class="lbl">Дистанция</div>
        <div class="v"><span id="h-dist">0</span><i>м</i></div>
        <div class="spd"><span id="h-kmh">0</span> км/ч</div>
      </div>
      <div class="right">
        <div class="sclbl">Очки</div>
        <div class="scv" id="h-score">0</div>
        <div class="bestchip">рекорд <span id="h-best">0</span></div>
        <div class="icons">
          <button class="ib" id="b-snd">♪</button>
          <button class="ib" id="b-pau">II</button>
        </div>
      </div>
    </div>
    <div class="combo" id="h-combo">×1.5</div>
    <div class="btm">
      <div class="hullwrap" id="h-hull">
        <div class="lbl">Корпус</div>
        <div class="hull"><i class="on"></i><i class="on"></i><i class="on"></i></div>
      </div>
      <button class="nitro" id="b-nitro" style="--f:0"><s>НИТРО</s></button>
    </div>
    <div class="banner" id="h-banner"></div>
  </div>

  <!-- СТАРТ -->
  <div class="wrap" id="scr-start">
    <div class="ghost">01</div>
    <div class="brand">
      <span class="season">Сезон 01 · Гравити</span>
      <h1 class="wordmark">Марбл<em>дром</em></h1>
      <p class="tagline">Стеклянные мраморы, крутый пинок гравитации и трасса, которая сужается каждый метр.</p>
    </div>
    <div class="sheet">
      <div class="grip"></div>
      <div class="strip">
        <div><i>Рекорд</i><b id="s-best">0</b></div>
        <div><i>Заездов</i><b id="s-runs">0</b></div>
        <div><i>Всего</i><b id="s-meters">0</b><i style="display:inline"> м</i></div>
        <div class="gr lg-name"><i>Лига</i><b id="s-league">Новичок</b></div>
      </div>
      <div class="lg"><span class="n" id="s-lg-cur">НОВИЧОК</span><span class="t"><span class="f" id="s-lg-f"></span></span><span class="n" id="s-lg-next">БРОНЗА</span></div>
      <button class="cta" id="b-play"><span>В путь <u>▸</u></span></button>
      <ul class="howto">
        <li><kbd>↔</kbd><span>Держи палец и <b>тяни</b> шар к нужной стороне — инерция никуда не денется</span></li>
        <li><kbd>M</kbd><span>Мраморы растят <b>серию</b>. Проходи вплотную к блокам — <b>+очки</b> за риск</span></li>
        <li><kbd>N</kbd><span>Нитро ускоряет на 50% и <b>удваивает</b> набор очков. Это ловушка, и она работает</span></li>
      </ul>
    </div>
  </div>

  <!-- ФИНИШ -->
  <div class="wrap off" id="scr-over">
    <div class="sheet">
      <div class="grip"></div>
      <div class="verdict" id="o-verdict">Заезд окончен</div>
      <div class="bigsc"><b id="o-score">0</b><i>очков</i></div>
      <div id="o-flare" style="display:none" class="flare">Новый рекорд дромома</div>
      <div class="grid4" style="margin-top:16px">
        <div><i>Дистанция</i><b><span id="o-dist">0</span><em> м</em></b></div>
        <div><i>Мраморы</i><b id="o-orbs">0</b></div>
        <div><i>Вплотную</i><b id="o-nm">0</b></div>
        <div><i>Макс. серия</i><b><em>×</em><span id="o-mult">1.0</span></b></div>
      </div>
      <div class="lg"><span class="n" id="o-lg-cur">НОВИЧОК</span><span class="t"><span class="f" id="o-lg-f"></span></span><span class="n" id="o-lg-next">до БРОНЗЫ 700</span></div>
      <button class="cta" id="b-again"><span>Ещё раз <u>↻</u></span></button>
      <div class="hint">тапни в любом месте</div>
    </div>
  </div>

  <!-- ПАУЗА -->
  <div class="wrap off" id="scr-pause" style="background:rgba(4,12,15,.72)">
    <div class="pausecard">
      <h3>Пауза</h3>
      <button class="cta" id="b-resume"><span>Продолжить</span></button>
      <button class="cta ghostbtn" id="b-quit"><span>В боксы</span></button>
    </div>
  </div>
</div>

<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script>
(()=>{
'use strict';
/* ═══ Telegram ═══ */
const tg = window.Telegram && window.Telegram.WebApp;
try{
  if(tg){ tg.ready(); tg.expand();
    tg.setHeaderColor && tg.setHeaderColor('#050e12');
    tg.setBackgroundColor && tg.setBackgroundColor('#050e12');
    tg.disableVerticalSwipes && tg.disableVerticalSwipes();
    if(tg.BackButton){ tg.BackButton.show();
      tg.BackButton.onClick(()=>{ if(G.mode==='play') pause(); else if(G.mode==='pause') resume(); });
    }
  }
}catch(e){}
function haptic(k){ try{ if(!tg||!tg.HapticFeedback) return;
  if(k==='sel') tg.HapticFeedback.selectionChanged();
  else if(k==='err') tg.HapticFeedback.notificationOccurred('error');
  else if(k==='ok') tg.HapticFeedback.notificationOccurred('success');
  else tg.HapticFeedback.impactOccurred(k);
}catch(e){} }

/* ═══ утилиты ═══ */
const $=s=>document.querySelector(s);
const clamp=(v,a,b)=>v<a?a:v>b?b:v;
const lerp=(a,b,t)=>a+(b-a)*t;
const rnd=(a,b)=>a+Math.random()*(b-a);
const fmt=n=>Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,'\u2009');

/* ═══ хранилище ═══ */
const SV={best:0,runs:0,meters:0,orbs:0,mute:false};
try{ Object.assign(SV, JSON.parse(localStorage.getItem('marblemall')||'{}')); }catch(e){}
const save=()=>{ try{ localStorage.setItem('marblemall',JSON.stringify(SV)); }catch(e){} };

const LEAGUES=[
 {n:'НОВИЧОК',s:0},{n:'БРОНЗА',s:700},{n:'СЕРЕБРО',s:2000},
 {n:'ЗОЛОТО',s:4500},{n:'ПЛАТИНА',s:9000},{n:'АБСОЛЮТ',s:18000}
];
function leagueOf(sc){ let i=0; for(let j=0;j<LEAGUES.length;j++) if(sc>=LEAGUES[j].s) i=j;
  const cur=LEAGUES[i], nx=LEAGUES[i+1];
  return {cur,nx,p:nx?clamp((sc-cur.s)/(nx.s-cur.s),0,1):1}; }

/* ═══ звук ══ */
let AC=null,master=null,engOsc=null,engGain=null,engFilt=null,nb=null;
function audioInit(){
  if(AC) return;
  try{
    AC=new (window.AudioContext||window.webkitAudioContext)();
    master=AC.createGain(); master.gain.value=SV.mute?0:.85; master.connect(AC.destination);
    const len=Math.floor(AC.sampleRate*.6); nb=AC.createBuffer(1,len,AC.sampleRate);
    const ch=nb.getChannelData(0); for(let i=0;i<len;i++) ch[i]=Math.random()*2-1;
    engOsc=AC.createOscillator(); engOsc.type='sawtooth'; engOsc.frequency.value=55;
    engFilt=AC.createBiquadFilter(); engFilt.type='lowpass'; engFilt.frequency.value=380;
    engGain=AC.createGain(); engGain.gain.value=0;
    engOsc.connect(engFilt); engFilt.connect(engGain); engGain.connect(master); engOsc.start();
  }catch(e){ AC=null; }
}
function tone(f,dur,type,vol,slide){
  if(!AC||SV.mute) return;
  const t=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();
  o.type=type||'square'; o.frequency.setValueAtTime(f,t);
  if(slide) o.frequency.exponentialRampToValueAtTime(Math.max(30,slide),t+dur);
  g.gain.setValueAtTime(0,t); g.gain.linearRampToValueAtTime(vol||.1,t+.008);
  g.gain.exponentialRampToValueAtTime(.0001,t+dur);
  o.connect(g); g.connect(master); o.start(); o.stop(t+dur+.03);
}
function nz(dur,vol,freq,q){
  if(!AC||SV.mute) return;
  const t=AC.currentTime,s=AC.createBufferSource(),g=AC.createGain(),f=AC.createBiquadFilter();
  s.buffer=nb; f.type='bandpass'; f.frequency.value=freq; f.Q.value=q||1;
  g.gain.setValueAtTime(vol,t); g.gain.exponentialRampToValueAtTime(.0001,t+dur);
  s.connect(f); f.connect(g); g.connect(master); s.start(); s.stop(t+dur+.02);
